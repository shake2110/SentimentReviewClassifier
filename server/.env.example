# Copy to .env and adjust. Every value has a sensible development default.
APP_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=aspectlens
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRES_HOURS=168
PORT=5050
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# full = sentence-transformer + BERT star model, lite = keywords + word lists (no downloads)
NLP_MODE=full
WARM_MODELS=1
